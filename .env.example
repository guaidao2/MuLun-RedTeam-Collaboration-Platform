# 复制为 .env 并填写（.env 已被 git 忽略，勿提交真实值）
# 必填：https 反代 + 对外访问都依赖强随机密钥
REDTEAM_JWT_SECRET=请改成强随机值，例如 openssl rand -hex 32
# 可选：覆盖默认 admin 口令（仅内存，不改源码）
REDTEAM_ADMIN_PASSWORD=
# 可选 MCP 加固：仅当需要开启 mcp DNS-rebinding 防护时填（默认关闭，避免公网 IP 被 421 拦）
# 逗号分隔的允许 Host，如 my.domain.com,8.145.41.135:5001
REDTEAM_MCP_ALLOWED_HOSTS=
